@*Cách 1 dùng để duyệt và hiển thị dữ liệu, thích hợp cho View*@
@* @model IEnumerable<SportsStore.Domain.Product>;  *@
@*Cách 2 dùng để xây dựng truy vấn*@
@model IQueryable<SportsStore.Domain.Product>;

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    @* <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p> *@
    <ul>
        @foreach (var product in Model)
        {
            <li>@product.ProductID - @product.name - @product.Description - @product.Category - @product.Price</li>
        }
    </ul>

   <div class="product-list">
        @foreach (var product in Model)
        {
            <div class="product-item">
                <p>@product.ProductID - @product.name - @product.Description - @product.Category - @product.Price</p>
            </div>
        }
   </div>

   <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Caregory</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
           
            @foreach(var product in Model)
            {
                <tr>
                    <td>@product.ProductID</td>
                    <td>@product.name</td>
                    <td>@product.Description</td>
                    <td>@product.Category</td>
                    <td>@product.Price</td>
                </tr>
            }
           
        </tbody>
    </table>
</div>
