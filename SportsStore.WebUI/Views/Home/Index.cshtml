@*Cách 1 dùng để duyệt và hiển thị dữ liệu, thích hợp cho View*@
@* @model IEnumerable<SportsStore.Domain.Product>;  *@
@*Cách 2 dùng để xây dựng truy vấn*@
@model ProductListViewModel;

@{
    ViewData["Title"] = "Products";
}

<div class="row">
    @foreach(var p in Model.Products)
    {
        <div class="col-md-4 col mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@p.ImageUrl" alt="@p.name" class="card-img-top p-3" style="height:250px; object-fit: contain"/>
                <div class="card-body">
                    <h5 class="card-title">
                        @p.name
                        <span class="badge bg-primary rounded-pill float-end">
                            @p.Price.ToString("c")
                        </span>
                    </h5>
                    <p class="card-text">@p.Description</p>
                </div>
                <div class="card-footer text-center">
                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@p.ProductID" class="btn btn-success" >Add To Cart</a>
                </div>
            </div>
           
        </div>
    }
   
</div>
<div page-model="@Model.PagingInfo" page-action="Index" class="btn btn-group float-end"></div>
