
<!DOCTYPE html>  
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width-device-width , initial-scale=1.0"/>
        <title>@ViewData["Title"] - SportsStore</title>
        <link href="~/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/fontawesome.min.css" integrity="sha512-WAQldzapOKc+yIZB/g4npsWhF43dQ74uxwR6WkySVIKVGKaVNSuRw19CQeqN2OmYmg34g7TsZv3sh9nsQXYj3g==" crossorigin="anonymous" referrerpolicy="no-referrer" />
     </head>
    <body>
        <header class="bg-dark text-white p-2">
            <div class="container-fluid">
                <span class="navbar-brand m-2">SPORTS STORE</span>
            @await Component.InvokeAsync("CartSummary")
            </div>
        </header>
        <div class="container-fluid mt-4">
            <div class="row">
                <aside class="col-md-3">
                @await Component.InvokeAsync("NavigationMenu")
                 </aside>
                <main class="col-md-9">
                    @RenderBody()
                </main>
            </div>
            
                
            
        </div>
        <footer class="border-top footer text-muted text-center p-3">
            <div class="container">
                &copy; 2025 - SportsStore
            </div>
        </footer>
        <script src="~/js/bootstrap.bundle.min.js"></script>
    </body>
</html>