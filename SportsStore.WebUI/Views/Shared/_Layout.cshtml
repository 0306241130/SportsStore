<!DOCTYPE html>  
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width-device-width , initial-scale=1.0"/>
        <title>@ViewData["Title"] - SportsStore</title>
        <link href="~/css/bootstrap.min.css" rel="stylesheet" />
     </head>
    <body>
        <header class="bg-dark text-white p-2">
            <div class="container-fluid">
                <span class="navbar-brand m-2">SPORTS STORE</span>
            </div>
        </header>
        <div class="container-fluid mt-4">
            <div class="row">
                <aside class="col-md-3">
                    <div class="container-md">
                    <div class="row">
                        <ul class="bg-dark list-unstyled d-flex flex-column gap-3 align-items-center p-md-3 rounded-3">
                            <li><a class="text-white text-decoration-none" asp-controller="Home" asp-action="About">About</a></li>
                            <li><a class="text-white text-decoration-none" asp-controller="Home" asp-action="Contact">Contact</a></li>
                            <li><a class="text-white text-decoration-none" asp-controller="Home" asp-action="Product">Product</a></li>
                        </ul>
                    </div>
                    </div>
                    
                </aside>
                <main class="col-md-9">
                    @RenderBody()
                </main>
            </div>
        </div>
        <footer class="border-top footer text-muted text-center p-3">
            <div class="container">
                &copy; 2025 - SportsStore
            </div>
        </footer>
        <script src="~/js/bootstrap.bundle.min.js"></script>
    </body>
</html>