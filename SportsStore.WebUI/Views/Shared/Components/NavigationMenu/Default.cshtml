@model IEnumerable<string>
<div class="d-grid gap-2">
	<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary" asp-route-category="">Home</a>
	@foreach(var category in Model)
	{
		<a class="btn btn-outline-secondary"
			asp-action="Index"	
			asp-controller="Home"
			asp-route-category="@category"
		>	
			@category
		</a>
	}
</div>