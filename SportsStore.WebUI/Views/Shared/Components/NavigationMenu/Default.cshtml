@model IEnumerable<SportsStore.Domain.Product>
<div class="d-grid gap-2">
	<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary" asp-route-category="">Home</a>
	@foreach(var category in Model)
	{
		<a asp-controller="Home" asp-action="Index" asp-route-category="@category.Category" class="btn btn-outline-secondary">@category.Category</a>
	}
</div>