@model IEnumerable<string>
<div class="d-grid gap-2 sticky-md-top">
	<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary" asp-route-category="">Home</a>
	@foreach(var category in Model)
	{

		@if (category == ViewBag.SelectedCategory )
		{
			<a asp-controller="Home" asp-action="Index" class="btn btn-secondary" asp-route-category="@category">@category</a>
		}
		else
		{
			<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary" asp-route-category="@category">@category</a>
		}

		@* <a class="btn btn-outline-secondary"
			asp-action="Index"	
			asp-controller="Home"
			asp-route-category="@category"
		>	
			@category
		</a> *@

	}
</div>