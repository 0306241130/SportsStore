@model SportsStore.Domain.Cart

<div class="d-inline">
	@if(Model.Lines.Count() > 0)
	{
		<small class="navbar-text">
			<b>Your cart:</b>
			@Model.Lines.Sum(x => x.Quantity) items(s)
			@Model.ComputeTotalValue().ToString("c")
		</small>
	}
	<a class="btn btn-sm btn-secondary  "
	   asp-controller="Cart" asp-action="Index" asp-route-returnUrl="@(ViewContext.HttpContext.Request.Path +
							  ViewContext.HttpContext.Request.QueryString.ToUriComponent())">
	 <i class="fa fa-shopping-cart"></i>
	</a>
</div>