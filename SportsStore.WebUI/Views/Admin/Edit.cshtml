@model SportsStore.Domain.Product
@{
	ViewData["Title"] = Model.ProductId == 0 ? "Create Product" : "Edit Product";
	Layout = "_AdminLayout";
}
<h3 class="mb-3">Edit Product: @Model.Name</h3>
<form asp-action="@(Model.ProductId ==0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
	<div asp-validation-summary="All" class="text-danger"></div>
	<input type="hidden" asp-for="ProductId"/>
	<input type="hidden" asp-for="ImgUrl"/>
	<div class="form-group mb-3">
		<label asp-for="Name"></label>
		<input asp-for="Name" class="form-control"/>
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>
	<div class="form-group mb-3">
		<label asp-for="Description"></label>
		<textarea asp-for="Description" class="form-control" > </textarea>
		<span asp-validation-for="Description" class="text-danger"></span>
	</div>
	<div class="form-group mb-3">
		<label asp-for="Price"></label>
		<input asp-for="Price" class="form-control" />
		<span asp-validation-for="Price" class="text-danger"></span>
	</div>
	<div class="form-group mb-3">
		<label >Image</label>
		<input type="file" name="Image" class="form-control" />
	
	</div>
	<div class="text-center">
		<button class="btn btn-primary" type="submit">Save</button>
		<a asp-action="Index" class="btn btn-secondary">Cancel</a>
	</div>
</form>